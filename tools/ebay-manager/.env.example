# ebay-manager 用シークレット設定
# このファイルは .env にコピーして実値を記入。.env は .gitignore 済み。

# Claude API（仕入先候補評価 claude_evaluator.py で使用）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# eBay Trading API (ebay_sync / ebay_client / supplier_apply 等で使用)
# developer.ebay.com で取得
EBAY_APP_ID=YourAppID
EBAY_DEV_ID=YourDevID
EBAY_CERT_ID=YourCertID
EBAY_USER_TOKEN=v^1.1...your_long_token...

# Google AI Studio (Gemini 2.5 Pro動画学習で使用)
# https://aistudio.google.com/apikey で取得
GOOGLE_API_KEY=AIzaSy...

# Discord Webhook URL (W293 eBaymag セッション維持: 切れ/復活通知)
# DISCORD_WEBHOOK_URL にフォールバックするため任意だが、専用 ch を推奨
# security: 実値はここに書かず .env に記載 (.gitignore 済み)
DISCORD_ACTION_REQUIRED_WEBHOOK_URL=
